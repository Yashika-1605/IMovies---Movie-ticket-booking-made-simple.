# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/imovies?retryWrites=true&w=majority

# JWT Authentication Secret & Expiration
JWT_SECRET=imovies_super_secure_jwt_secret_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Admin Initial Credentials (for seed script)
ADMIN_NAME=Admin IMovies
ADMIN_EMAIL=admin@imovies.com
ADMIN_PASSWORD=Admin@123
